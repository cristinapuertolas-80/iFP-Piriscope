# Copia este fichero como .env (no se versiona) y rellena tus claves.

# AEMET OpenData: https://opendata.aemet.es/centrodedescargas/altaUsuario
AEMET_API_KEY=

# Early Warning Data Store de Copernicus (FWI): https://ewds.climate.copernicus.eu
CDSAPI_URL=https://ewds.climate.copernicus.eu/api
CDSAPI_KEY=

# Hugging Face: token fine-grained con escritura SOLO sobre el dataset
HF_TOKEN=
HF_REPO_ID=cpuertolas/piriscope

# Opcionales (valores por defecto entre paréntesis)
# AEMET_MAX_DIAS=180            # días por petición (AEMET limita a 6 meses)
# AEMET_PAUSA_SEGUNDOS=1.5      # pausa entre peticiones
# AEMET_DIAS_CONSOLIDACION=30   # tramos más antiguos se reutilizan de la caché
# EFFIS_DATASET_TYPE=consolidated_dataset   # o intermediate_dataset (meses recientes)
# EFFIS_ESPERA_COLA=120         # segundos de espera si el EWDS tiene la cola llena
# EFFIS_MAX_REINTENTOS_COLA=15  # reintentos antes de detener la carga
# PIRISCOPE_DATA_DIR=./data
